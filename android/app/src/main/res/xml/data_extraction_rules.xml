<?xml version="1.0" encoding="utf-8"?>
<!-- Se a titkosított API kulcs, se a telepítési azonosító nem mehet át másik készülékre:
     az előbbi visszaállítva úgysem olvasható, az utóbbiból pedig két eszköz osztozna
     egyetlen havi kereten. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="mealpilot_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="mealpilot_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
